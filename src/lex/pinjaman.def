// --------------------------------------------- C / C++ / Java / Kotlin / Rust
JAWA_PINJAMAN("fun", Kunci, "gawe")
JAWA_PINJAMAN("fn", Kunci, "gawe")
JAWA_PINJAMAN("func", Kunci, "gawe")
JAWA_PINJAMAN("match", Kunci, "cocog")
JAWA_PINJAMAN("use", Kunci, "impor")
JAWA_PINJAMAN("val", Kunci, "tetep")
JAWA_PINJAMAN("int", Bawaan, "angka")
JAWA_PINJAMAN("float", Bawaan, "angka")
JAWA_PINJAMAN("str", Bawaan, "teks")

// ------------------------------------------- fungsi & properti bawaan lain
JAWA_PINJAMAN("print", Bawaan, "tulis")
JAWA_PINJAMAN("printf", Bawaan, "tulis")
JAWA_PINJAMAN("puts", Bawaan, "tulis")
