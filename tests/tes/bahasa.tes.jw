// Uji bahasa inti untuk `jawa tes`.
//
// Fungsi bawaan: `pratelas`, `wajib_bener`, `wajib_salah`, `wajib_lempar`.
// Lihat `docs/testing.md` untuk penjelasan lengkap.
//
// CATATAN: kata kunci deklarasi variabel adalah `ana` (ngoko) / `wonten` (krama)
// dan `tetep` untuk konstanta. `let` BUKAN keyword di Basa Jawa, dan nilai
// boolean ditulis `bener` / `salah` (bukan `true` / `false`).

// --- aritmetika & operator -------------------------------------------------
pratelas(1 + 1, 2);
pratelas(7 - 2, 5);
pratelas(6 * 7, 42);
pratelas(7 / 2, 3.5);
pratelas(7 % 3, 1);
pratelas(2 ** 10, 1024);
pratelas(0 - 5, -5);
pratelas(0 - (3), -3);

// Beda tipe tidak boleh dianggap sama (D-007: tanpa koersi implisit).
pratelas(1 == "1", salah);
pratelas(1 == 1, bener);

// --- teks ------------------------------------------------------------------
pratelas("a" + "b", "ab");
pratelas(Teks(42), "42");
pratelas("Halo".dawa(), 4);
pratelas("Halo".huruf_kecil(), "halo");
pratelas("a-b-c".ganti("-", "+"), "a+b+c");
pratelas("a,b,c".pecah(",").panjang, 3);
wajib_bener("abc".termasuk("b"));
wajib_bener("abc".mulainya_dengan("ab"));
wajib_salah("abc".termasuk("z"));

// --- dhaptar ---------------------------------------------------------------
pratelas([1, 2, 3].panjang, 3);
pratelas([1, 2, 3].peta((x) => x * 2), [2, 4, 6]);
pratelas([1, 2, 3, 4].saring((x) => x % 2 == 0), [2, 4]);
pratelas([1, 2, 3].saben((x) => x > 0), bener);
pratelas([1, 2, 3].kurangi((a, b) => a + b), 6);

ana dh = [1];
dh.tambah(2, 3);
pratelas(dh, [1, 2, 3]);
pratelas(dh.copot(), 3);
pratelas(dh, [1, 2]);

// --- operator logis (short-circuit) ----------------------------------------
wajib_bener(bener lan bener);
wajib_salah(bener lan salah);
wajib_bener(salah utawa bener);
wajib_salah(salah utawa salah);
wajib_bener(ora salah);
pratelas(1 < 2, bener);

// --- `kanggo` klasik -------------------------------------------------------
ana total = 0;
kanggo (ana i = 0; i < 5; i = i + 1) total = total + i;
pratelas(total, 10);

// --- `kanggo ... saka` -----------------------------------------------------
ana ranten = "";
kanggo (x saka [1, 2, 3]) ranten = ranten + Teks(x);
pratelas(ranten, "123");

// Basa Jawa tidak mengoersi `+` (D-007): teks + angka harus lewat `Teks()`.
gawe jumlah_teks_angka() { bali "" + 1; }
wajib_lempar(jumlah_teks_angka, "teks + angka tanpa koersi harus galat");

// --- `nalika` --------------------------------------------------------------
ana hitung_nalika = 0;
nalika (hitung_nalika < 3) hitung_nalika = hitung_nalika + 1;
pratelas(hitung_nalika, 3);

// --- `mandheg` -------------------------------------------------------------
// `mandheg` harus keluar dari loop SEBELUM sisa nilai body dibuang: kalau tidak,
// satu `POP` terlalu banyak memakan nilai milik frame pemanggil.
ana ketemu = 0;
kanggo (x saka [1, 2, 3, 4]) {
    yen (x == 3) { ketemu = x; mandheg; }
}
pratelas(ketemu, 3);

ana hitung = 0;
nalika (hitung < 5) {
    hitung = hitung + 1;
    yen (hitung == 3) { mandheg; }
}
pratelas(hitung, 3);

// `mandheg` di `kanggo` klasik.
anaCLASSIC = 0;
kanggo (ana i = 0; i < 5; i = i + 1) {
    yen (i == 2) { anaCLASSIC = i; mandheg; }
}
pratelas(anaCLASSIC, 2);

// --- `terusna` -------------------------------------------------------------
ana jumlah_terusna = 0;
kanggo (ana i = 0; i < 5; i = i + 1) {
    yen (i == 1) { terusna; }
    jumlah_terusna = jumlah_terusna + i;
}
pratelas(jumlah_terusna, 0 + 2 + 3 + 4);

// --- pengikat per-iterasi `kanggo` -----------------------------------------
// `kanggo (ana i = ...)` mengikat per-iterasi (lihat D-037): tiap closure
// harus melihat nilai `i` pada iterasinya, bukan nilai iterasi terakhir.
ana tangkap_klasik = [];
kanggo (ana i = 0; i < 3; i = i + 1) tangkap_klasik.tambah(() => i);
pratelas(tangkap_klasik[0](), 0);
pratelas(tangkap_klasik[1](), 1);
pratelas(tangkap_klasik[2](), 2);

// Pengikut `kanggo` sekarang punya skop sendiri, jadi nama yang sama di loop
// lain dalam fungsi yang sama tidak bentrok. Libur dulu nama-nama ini harus
// unik sepanjang berkas karena slot kompilator bersifat fungsi-wide.
ana tangkap_of = [];
kanggo (ana huruf saka ["a", "b", "c"]) tangkap_of.tambah(() => huruf);
pratelas(tangkap_of[0](), "a");
pratelas(tangkap_of[1](), "b");
pratelas(tangkap_of[2](), "c");

// Dua loop dengan nama pengikut yang sama dalam satu fungsi. Dulu ini memicu
// `KleruCakupan [S401]`.
ana jumlah_skop = 0;
kanggo (ana i = 0; i < 3; i = i + 1) { jumlah_skop = jumlah_skop + i; }
kanggo (ana i = 10; i < 12; i = i + 1) { jumlah_skop = jumlah_skop + i; }
pratelas(jumlah_skop, 3 + 21);

// Dua blok sibling dengan nama yang sama.
{
    ana x = "kiri";
    pratelas(x, "kiri");
}
{
    ana x = "kanan";
    pratelas(x, "kanan");
}

// Pengikut loop TIDAK terlihat di luar loopnya: di luar itu zona
// mati-temporal, sama seperti `let` di ECMAScript.
// Pengikut loop tidak terlihat di luar loopnya. Di luar, `i` bukan variabel
// loop lagi: yang terbaca adalah global bernama `i` (yang tidak ada), bukan
// nilai iterasi terakhir. Dulu slot-nya fungsi-wide, jadi `pratelas(i, 3)`
// masih berlaku.
gawe baca_i_setelah_loop() {
    kanggo (ana idx_geser = 0; idx_geser < 3; idx_geser = idx_geser + 1) { }
    bali idx_geser;
}
pratelas(baca_i_setelah_loop(), mboh);

// Loop tanpa closure harus berperilaku sama seperti sebelumnya.
ana jumlah_klasik = 0;
kanggo (ana i = 1; i <= 4; i = i + 1) jumlah_klasik = jumlah_klasik + i;
pratelas(jumlah_klasik, 1 + 2 + 3 + 4);

// `terusna` juga harus menyalin sel: kalau tidak, pembaruan menulis ke sel yang
// sudah ditangkap closure iterasi itu.
ana tangkap_terusna = [];
kanggo (ana i = 0; i < 4; i = i + 1) {
    tangkap_terusna.tambah(() => i);
    yen (i == 1) { terusna; }
}
pratelas(tangkap_terusna.panjang, 4);
pratelas(tangkap_terusna[0](), 0);
pratelas(tangkap_terusna[1](), 1);
pratelas(tangkap_terusna[2](), 2);
pratelas(tangkap_terusna[3](), 3);

// `mandheg` keluar sebelum salinan -- tidak ada iterasi tambahan.
ana tangkap_mandheg = [];
kanggo (ana i = 0; i < 5; i = i + 1) {
    tangkap_mandheg.tambah(() => i);
    yen (i == 2) { mandheg; }
}
pratelas(tangkap_mandheg.panjang, 3);
pratelas(tangkap_mandheg[2](), 2);

// --- `lakoni` (minimal sekali) ---------------------------------------------
ana dihitung = 0;
lakoni { dihitung = dihitung + 1; } nalika (dihitung < 3);
pratelas(dihitung, 3);

// --- `yen` / `liyane` ------------------------------------------------------
ana cabang = 0;
yen (bener) { cabang = 1; } liyane { cabang = 2; }
pratelas(cabang, 1);
yen (salah) { cabang = 3; } liyane { cabang = 4; }
pratelas(cabang, 4);

// --- fungsi, closure, rekursi ----------------------------------------------
gawe tambah(a, b) { bali a + b; }
pratelas(tambah(2, 3), 5);

gawe penghitung() {
    ana n = 10;
    gawe nambah(s) { bali n + s; }
    bali nambah;
}
pratelas(penghitung()(5), 15);

gawe fib(n) { yen (n < 2) { bali n; } bali fib(n - 1) + fib(n - 2); }
pratelas(fib(10), 55);

// Parameter default & rest.
gawe greet(sapaan = "Halo") { bali sapaan; }
pratelas(greet(), "Halo");
pratelas(greet("Dumet"), "Dumet");
// `mboh` yang SENGAJA diberikan bukan "argumen tidak diberikan" (D-036).
gawe mungkin(a, b = "default") { bali jenis(b) == "mboh" ? "mboh" : b; }
pratelas(mungkin(1), "default");
pratelas(mungkin(1, mboh), "mboh");
pratelas(mungkin(1, "ada"), "ada");
// Nilai falsy bukan nullish: `0`, `kosong`, `salah`, `""` tidak memicu default.
gawe falsy(a = "default") { bali a; }
pratelas(falsy(0), 0);
pratelas(falsy(kosong), kosong);
pratelas(falsy(salah), salah);
pratelas(falsy(""), "");
pratelas(falsy(), "default");
// Rantai default: yang tidak diberikan memakai default, yang diberikan tidak.
gawe rantai(a = 1, b = 2, c = 3) { bali `${a}-${b}-${c}`; }
pratelas(rantai(), "1-2-3");
pratelas(rantai(9), "9-2-3");
pratelas(rantai(9, 8), "9-8-3");
pratelas(rantai(9, 8, 7), "9-8-7");

// Arrow ringkas.
ana kali_kali = (a, b) => a * b;
pratelas(kali_kali(6, 7), 42);
ana kali_kali2 = (a) => a * 2;
pratelas(kali_kali2(21), 42);

// --- kelas -----------------------------------------------------------------
// Field harus dideklarasikan di badan class; `iki.sisi = ...` tanpa deklarasi
// tidak membuat field, dan `iki.sisi` jadi `mboh`.
golongan Kotak {
    sisi;
    wiwit(sisi) { iki.sisi = sisi; }
    luas() { bali iki.sisi * iki.sisi; }
    statis bounty() { bali 4; }
}
pratelas(anyar Kotak(5).luas(), 25);
pratelas(Kotak.bounty(), 4);

// Field privat + accessor.
golongan KotakPriba {
    #sisi;
    wiwit(sisi) { iki.#sisi = sisi; }
    nampa sisi() { bali iki.#sisi; }
}
pratelas(anyar KotakPriba(3).sisi, 3);

// Field berinisialisasi: `= <ekspresi>` berjalan sebelum `wiwit`.
golongan KotakIsi {
    sisi = 5;
}
pratelas(anyar KotakIsi().sisi, 5);
golongan KotakTiban {
    sisi = 5;
    wiwit() { iki.sisi = iki.sisi + 1; }
}
pratelas(anyar KotakTiban().sisi, 6);
golongan PribaIsi {
    #sisi = 7;
    nampa sisi() { bali iki.#sisi; }
}
pratelas(anyar PribaIsi().sisi, 7);
// Inisialisasi bisa memakai variabel luar (upvalue) dan `iki`.
tetep alas_field = 10;
golongan TanggaField {
    y = alas_field + 5;
}
pratelas(anyar TanggaField().y, 15);
golongan IndukField {
    a = 1;
}
golongan AnakField turunan IndukField {
    b = 2;
}
pratelas(anyar AnakField().a, 1);
pratelas(anyar AnakField().b, 2);
// Field statis bernilai.
golongan StatisField {
    statis x = 42;
}
pratelas(StatisField.x, 42);

// --- pola `cocog` ----------------------------------------------------------
gawe kelompok(x) {
  bali cocog (x) {
    kasus 0 => "nol",
    kasus [a, b] => "pasangan",
    kasus {jeneng, umur} => jeneng,
    kasus _ => "liyane"
  };
}
pratelas(kelompok(0), "nol");
pratelas(kelompok([1, 2]), "pasangan");
pratelas(kelompok({jeneng: "Sari", umur: 20}), "Sari");
pratelas(kelompok("lain"), "liyane");

// --- penanganan galat ------------------------------------------------------
gawe tangkap_nilai() {
    ana hasil = "nihil";
    coba { uncal "bahaya" } tangkep (err) { hasil = err; }
    bali hasil;
}
pratelas(tangkap_nilai(), "bahaya");

// Galat di dalam fungsi yang dipanggil dari `coba` harus ikut tertangkap.
gawe melempar_dalam() { uncal "dari dalam"; }
gawe tangkap_dalam() {
    ana hasil = "nihil";
    coba { melempar_dalam() } tangkep (err) { hasil = err; }
    bali hasil;
}
pratelas(tangkap_dalam(), "dari dalam");

// --- zona mati-temporal ----------------------------------------------------
// Membaca `nilai_tdz` sebelum deklarasinya dievaluasi harus melempar, bukan
// menghasilkan `mboh`. Yang di-pra-daftarkan sebagai zona mati-temporal adalah
// badan modul & badan fungsi; baca lewat closure (upvalue) BELUM memakai
// TDZ_CHECK -- lihat STATUS.md.
gawe baca_nanti() { bali nilai_tdz; }
ana nilai_tdz = 1;
pratelas(nilai_tdz, 1);
pratelas(baca_nanti(), 1);

// --- pipeline --------------------------------------------------------------
pratelas(5 |> (x => x * 2), 10);
pratelas(1 |> (x => x + 1) |> (x => x * 2), 4);

// --- bayangan nama (shadowing) --------------------------------------------
// Closure WAJIB membaca `n` lokal di `penghitung`, bukan `n` modul yang
// namanya sama. Kalau resolusi upvalue memindai semua nenek moyang sekaligus,
// Closure ini menangkap slot modul dan `hasil` salah.
ana bayangan = 0;
gawe penghitung_bayang() {
    ana n = 10;
    gawe tambah_lokal(s) { bali n + s; }
    bali tambah_lokal;
}
pratelas(penghitung_bayang()(5), 15);
pratelas(bayangan, 0);

// Tiga tingkat bersarang: closure paling dalam harus membaca `n` milik
// `tengah`, bukan `n` modul maupun `n` milik `luar`. Setiap tingkat punya
// `n` dengan nilai berbeda, jadi satu slot yang salah langsung terlihat.
ana n = 1;
gawe luar() {
    ana n = 2;
    gawe tengah() {
        ana n = 3;
        gawe dalam() { bali n; }
        bali dalam;
    }
    bali tengah;
}
pratelas(luar()()(), 3);
pratelas(n, 1);

// Closure yang HANYA meneruskan nilai upvalue (tidak pernah membacanya sendiri
// di badannya) harus tetap meneruskannya. Kalau fungsi perantara tidak
// mendaftarkan upvalue-nya, closure innermost membaca sel kosong -> `mboh`.
gawe penerus() {
    ana q = 9;
    bali gawe () { bali q; };
}
pratelas(penerus()(), 9);
